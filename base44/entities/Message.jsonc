{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Message text"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Set once the recipient has opened the thread"
    }
  },
  "required": [
    "sender_email",
    "recipient_email",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "update": {
      "data.recipient_email": "{{user.email}}"
    },
    "delete": {
      "data.sender_email": "{{user.email}}"
    }
  }
}